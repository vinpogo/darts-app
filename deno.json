{
  "tasks": {
    "dev": "deno task dev:api & deno task dev:fe",
    "dev:api": "deno run --watch --unstable-no-legacy-abort --allow-read --allow-write --allow-net ./api/main.ts",
    "dev:fe": "deno run -A npm:vite"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.7.4",
    "@primeuix/themes": "npm:@primeuix/themes@^1.2.5",
    "@primevue/themes": "npm:@primevue/themes@^4.4.1",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.14",
    "@untier/result": "jsr:@untier/result@^0.2.1",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^6.0.1",
    "@vue/tsconfig": "npm:@vue/tsconfig@^0.8.1",
    "@vueuse/core": "npm:@vueuse/core@^13.9.0",
    "hono": "npm:hono@^4.9.12",
    "ky": "npm:ky@^1.11.0",
    "primeicons": "npm:primeicons@^7.0.0",
    "primevue": "npm:primevue@^4.4.1",
    "tailwindcss": "npm:tailwindcss@^4.1.14",
    "tailwindcss-primeui": "npm:tailwindcss-primeui@^0.6.1",
    "types/": "./packages/types/",
    "~/": "./packages/",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "typescript": "npm:typescript@5.9.2",
    "vite": "npm:vite@^7.1.9",
    "vue": "npm:vue@^3.5.22",
    "vue-router": "npm:vue-router@^4.5.1",
    "vue-tsc": "npm:vue-tsc@^3.1.1",
    "zod": "npm:zod@^4.1.12"
  },
  "nodeModulesDir": "auto",
  "unstable": ["fmt-component", "kv"],
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  }
}
